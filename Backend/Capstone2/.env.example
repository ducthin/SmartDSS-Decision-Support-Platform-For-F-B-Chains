# === SmartDSS Backend Environment Variables ===
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the .env file to version control!

# Database
DB_URL=jdbc:mysql://localhost:3306/smartdss?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT Authentication
# Generate a Base64-encoded secret key (at least 256 bits / 32 bytes)
JWT_SECRET=your_base64_encoded_secret_key_here
JWT_EXPIRATION=86400000
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_DB_TIMEZONE=Asia/Ho_Chi_Minh

# Weather API (OpenWeatherMap) - https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Da Nang

# Calendarific API - https://calendarific.com/
CALENDARIFIC_API_KEY=your_calendarific_api_key

# Seed demo data (dev only)
APP_SEED_ENABLED=false

# Ensure roles exist in DB (recommended)
APP_ROLES_SYNC_ENABLED=true

# One-time migration: remove legacy STAFF role
APP_ROLES_MIGRATE_REMOVE_STAFF=true

# CORS / WebSocket allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Debug (set to true for development only)
SHOW_SQL=true

# Feedback anti-spam & alert tuning
# Production defaults
APP_FEEDBACK_IMAGE_MAX_SIZE_MB=4
APP_FEEDBACK_IMAGE_MAX_COUNT=4
APP_FEEDBACK_SPAM_COOLDOWN_MINUTES=2
APP_FEEDBACK_SPAM_MAX_PER_PHONE_24H=5
APP_FEEDBACK_SPAM_MAX_PER_TABLE_PER_MINUTE=3
APP_FEEDBACK_ALERT_LOW_RATING_THRESHOLD=2
APP_FEEDBACK_ALERT_CRITICAL_LOW_RATING_COUNT=2
APP_FEEDBACK_ALERT_WINDOW_MINUTES=30

# Vietnam VAT policy
APP_TAX_VAT_RATE_PERCENT=8
APP_TAX_PRICE_INCLUDES_VAT=true

# POS payment (VietQR + webhook)
APP_PAYMENT_BANK_BIN=970422
APP_PAYMENT_BANK_ACCOUNT=55777777686868
APP_PAYMENT_BANK_ACCOUNT_NAME=SMARTDSS CAFE
APP_PAYMENT_QR_EXPIRE_MINUTES=15
APP_PAYMENT_WEBHOOK_SECRET=replace_with_strong_random_secret
APP_PAYMENT_WEBHOOK_ALLOW_INSECURE=false

# PayOS integration
APP_PAYOS_CLIENT_ID=your_payos_client_id
APP_PAYOS_API_KEY=your_payos_api_key
APP_PAYOS_CHECKSUM_KEY=your_payos_checksum_key
APP_PAYOS_RETURN_URL=http://localhost:5173/payment/success
APP_PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# Payment logs (set DEBUG while testing webhook/local tunnel)
APP_LOG_LEVEL_PAYMENT_SERVICE=INFO
APP_LOG_LEVEL_PAYMENT_WEBHOOK=INFO
APP_LOGGING_PATTERN_LEVEL=%5p [req:%X{requestId:-}]
MANAGEMENT_ENDPOINTS_EXPOSE=health,info,metrics
