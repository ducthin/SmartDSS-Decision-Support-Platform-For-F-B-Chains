# === SmartDSS Backend Environment Variables ===
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the .env file to version control!

# Database
DB_URL=jdbc:mysql://localhost:3306/smartdss?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT Authentication
# Generate a Base64-encoded secret key (at least 256 bits / 32 bytes)
JWT_SECRET=your_base64_encoded_secret_key_here
JWT_EXPIRATION=86400000

# Weather API (OpenWeatherMap) - https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Da Nang

# Calendarific API - https://calendarific.com/
CALENDARIFIC_API_KEY=your_calendarific_api_key

# Seed demo data (dev only)
APP_SEED_ENABLED=false

# Ensure roles exist in DB (recommended)
APP_ROLES_SYNC_ENABLED=true

# One-time migration: remove legacy STAFF role
APP_ROLES_MIGRATE_REMOVE_STAFF=true

# CORS / WebSocket allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Debug (set to true for development only)
SHOW_SQL=true
