# === SmartDSS Backend Environment Variables ===
# Copy this file to .env and fill in your values

# Database
DB_URL=jdbc:mysql://localhost:3306/smartdss?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT Authentication
JWT_SECRET=your_base64_encoded_secret_key_here
JWT_EXPIRATION=86400000

# Weather API (OpenWeatherMap) - https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Da Nang

# Calendarific API - https://calendarific.com/
CALENDARIFIC_API_KEY=your_calendarific_api_key
