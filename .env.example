# ============================================================
# SmartDSS — Docker Compose Environment Variables
# Copy file này thành .env và điền giá trị thật
# ⚠️  KHÔNG commit file .env lên Git!
# ============================================================

# ─── Database ────────────────────────────────────────────────
DB_PASSWORD=your_strong_password_here

# ─── JWT ─────────────────────────────────────────────────────
# Tạo key mới: openssl rand -base64 32
JWT_SECRET=your_base64_jwt_secret_here
JWT_EXPIRATION=86400000

# ─── CORS (domain VPS của bạn) ───────────────────────────────
# Thay bằng IP hoặc domain thật, ví dụ: https://smartdss.yourdomain.com
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP,https://your-domain.com
WS_ALLOWED_ORIGINS=http://YOUR_VPS_IP,https://your-domain.com

# ─── Frontend URLs (dùng lúc build Docker image) ─────────────
# Phải là URL public để browser có thể gọi được
VITE_API_URL=http://YOUR_VPS_IP:8080/api/v1
VITE_WS_URL=ws://YOUR_VPS_IP:8080/ws
# Nếu có domain + SSL:
# VITE_API_URL=https://api.your-domain.com/api/v1
# VITE_WS_URL=wss://api.your-domain.com/ws

# ─── External APIs ───────────────────────────────────────────
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Da Nang
CALENDARIFIC_API_KEY=your_calendarific_api_key

# ─── Payment - PayOS ─────────────────────────────────────────
APP_PAYMENT_BANK_BIN=970422
APP_PAYMENT_BANK_ACCOUNT=55777777686868
APP_PAYMENT_BANK_ACCOUNT_NAME=SMARTDSS CAFE
APP_PAYMENT_WEBHOOK_SECRET=your_strong_webhook_secret
APP_PAYMENT_WEBHOOK_ALLOW_INSECURE=false
APP_PAYOS_CLIENT_ID=your_payos_client_id
APP_PAYOS_API_KEY=your_payos_api_key
APP_PAYOS_CHECKSUM_KEY=your_payos_checksum_key
APP_PAYOS_RETURN_URL=http://YOUR_VPS_IP/payment/success
APP_PAYOS_CANCEL_URL=http://YOUR_VPS_IP/payment/cancel

# ─── LLM (Groq / OpenAI) ─────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Email (Gmail SMTP) ───────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
APP_MAIL_FROM=your_email@gmail.com

# ─── Notifications ───────────────────────────────────────────
APP_NOTIFICATION_ENABLED=false
APP_NOTIFICATION_PROVIDER=TELEGRAM
APP_NOTIFICATION_CHANNEL=TELEGRAM
APP_NOTIFICATION_STORE_NAME=SmartDSS Coffee
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_USERNAME=@YourBotUsername
