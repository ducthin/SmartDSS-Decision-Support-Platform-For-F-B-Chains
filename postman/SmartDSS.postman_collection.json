{
  "info": {
    "_postman_id": "6d80788b-c7e6-4af4-bace-afe5b8a0ecf0",
    "name": "SmartDSS API",
    "description": "Full API collection for SmartDSS backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "1" },
    { "key": "categoryId", "value": "1" },
    { "key": "menuId", "value": "1" },
    { "key": "recipeId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "inventoryId", "value": "1" },
    { "key": "tableId", "value": "1" },
    { "key": "feedbackId", "value": "1" },
    { "key": "eventId", "value": "1" },
    { "key": "holidayId", "value": "1" },
    { "key": "qrToken", "value": "replace_with_real_qr_token" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Public Config",
      "item": [
        {
          "name": "Get Tax Policy",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/public/config/tax"
          }
        }
      ]
    },
    {
      "name": "Public QR",
      "item": [
        {
          "name": "Get Table Info",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/public/qr/{{qrToken}}/info"
          }
        },
        {
          "name": "Get Menu For QR",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/public/qr/{{qrToken}}/menu"
          }
        },
        {
          "name": "Place QR Order",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientSessionId\": \"{{qrClientSession}}\",\n  \"note\": \"Ít đá\",\n  \"orderItems\": [\n    { \"menuItemId\": 1, \"quantity\": 1 },\n    { \"menuItemId\": 2, \"quantity\": 2 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/public/qr/{{qrToken}}/order"
          }
        },
        {
          "name": "Get Table Orders",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/public/qr/{{qrToken}}/orders?sessionId={{qrClientSession}}"
          }
        },
        {
          "name": "Call Staff",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Cho em xin thêm khăn giấy\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/public/qr/{{qrToken}}/call"
          }
        },
        {
          "name": "Submit Feedback (multipart)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "customerName", "value": "Nguyen Van A", "type": "text" },
                { "key": "customerPhone", "value": "0900000000", "type": "text" },
                { "key": "customerEmail", "value": "a@example.com", "type": "text" },
                { "key": "rating", "value": "5", "type": "text" },
                { "key": "content", "value": "Dịch vụ tốt", "type": "text" },
                { "key": "images", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/public/qr/{{qrToken}}/feedback"
          }
        }
      ]
    },
    {
      "name": "Public Payment Webhooks",
      "item": [
        {
          "name": "Generic Webhook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Payment-Webhook-Secret", "value": "replace_with_webhook_secret" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"status\": \"PAID\",\n  \"amount\": 20000,\n  \"transferContent\": \"BILL-1\",\n  \"providerTransactionId\": \"TX123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/public/payments/webhook"
          }
        },
        {
          "name": "PayOS Webhook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"00\",\n  \"success\": true,\n  \"data\": {\n    \"orderCode\": 1000001,\n    \"amount\": 20000,\n    \"description\": \"BILL-1\",\n    \"code\": \"00\",\n    \"reference\": \"REF123\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/public/payments/payos/webhook"
          }
        }
      ]
    },
